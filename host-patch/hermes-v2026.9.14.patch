diff --git a/agent/memory_bridge.py b/agent/memory_bridge.py
new file mode 100644
index 0000000000..59270164e2
--- /dev/null
+++ b/agent/memory_bridge.py
@@ -0,0 +1,315 @@
+"""Optional host memory boundaries; backend-specific policy stays in providers.
+
+No model tools and no changes to a live conversation's cached prompt prefix.
+"""
+HOST_MEMORY_API = 2
+
+from dataclasses import dataclass
+from pathlib import Path
+from contextvars import ContextVar
+from contextlib import contextmanager
+from functools import wraps
+
+
+@dataclass(frozen=True)
+class MemoryHostContext:
+    home: str
+    kind: str
+    user_id: str = ""
+    identity_provider: str = ""
+    job_id: str = ""
+    run_id: str = ""
+    targets: tuple = ()
+    local_delivery: bool = False
+
+
+def gui_context(transport, home):
+    from tui_gateway.transport import StdioTransport, TeeTransport
+    while isinstance(transport, TeeTransport):
+        transport = transport._primary
+    if isinstance(transport, StdioTransport):
+        return MemoryHostContext(str(Path(home).resolve()), "local_owner")
+    from tui_gateway.ws import WSTransport
+    if isinstance(transport, WSTransport):
+        if getattr(transport, "memory_owner", False) is True:
+            return MemoryHostContext(str(Path(home).resolve()), "local_owner")
+        identity = transport.auth_identity
+        if isinstance(identity, dict) and identity.get("user_id") and identity.get("provider"):
+            return MemoryHostContext(str(Path(home).resolve()), "authenticated_user",
+                                     str(identity["user_id"]), str(identity["provider"]))
+    return None
+
+
+def target_keys(targets):
+    return tuple(sorted({(str(t["platform"]).lower(), str(t["chat_id"]), str(t.get("thread_id") or "")) for t in targets}))
+
+
+def cron_context(home, job, run_id, targets, local_delivery):
+    return MemoryHostContext(str(Path(home).resolve()), "cron", job_id=str(job["id"]),
+                             run_id=str(run_id), targets=target_keys(targets), local_delivery=bool(local_delivery))
+
+
+def emit(agent, event, payload):
+    manager = getattr(agent, "_memory_manager", None)
+    acknowledgements = []
+    for provider in getattr(manager, "providers", ()):
+        callback = getattr(provider, "on_host_event", None)
+        if callable(callback):
+            acknowledgement = callback(event, payload)
+            acknowledgements.append(acknowledgement)
+            if isinstance(acknowledgement, dict) and acknowledgement.get("state") in {"withheld", "failed"}:
+                raise RuntimeError("Memory event " + acknowledgement["state"] + ": " + acknowledgement.get("reason", ""))
+    return acknowledgements
+
+
+def delegation_packet(agent, goal):
+    manager = getattr(agent, "_memory_manager", None)
+    packets = []
+    for provider in getattr(manager, "providers", ()):
+        callback = getattr(provider, "delegation_context", None)
+        if callable(callback):
+            packet = callback(goal)
+            if packet: packets.append(str(packet))
+    return "\n\n".join(packets)
+
+
+def review_completed(agent, messages, prior):
+    import json
+    prior_ids = {m.get("tool_call_id") for m in prior if isinstance(m, dict) and m.get("role") == "tool"}
+    calls = {}
+    for message in messages:
+        if not isinstance(message, dict): continue
+        for call in message.get("tool_calls") or []:
+            if not isinstance(call, dict): continue
+            fn = call.get("function") or {}
+            if not isinstance(fn, dict): continue
+            if fn.get("name") not in {"skill_manage", "memory"}: continue
+            try: args = json.loads(fn.get("arguments") or "{}")
+            except (TypeError, ValueError): continue
+            if isinstance(args, dict): calls[call.get("id")] = (fn["name"], args)
+        cid = message.get("tool_call_id")
+        if message.get("role") != "tool" or not cid or cid in prior_ids or cid not in calls: continue
+        try: result = json.loads(message.get("content") or "{}")
+        except (TypeError, ValueError): continue
+        if not isinstance(result, dict) or result.get("success") is not True: continue
+        name, args = calls[cid]
+        emit(agent, "review_change", {"tool_call_id": cid, "tool": name, "arguments": args,
+                                     "result": result, "verified": False})
+
+
+def _profile_hook(home, name, *args):
+    import yaml
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    home = Path(home).resolve()
+    config = home / "config.yaml"
+    if not config.is_file(): return None
+    settings = yaml.safe_load(config.read_text()) or {}
+    provider_name = (settings.get("memory") or {}).get("provider")
+    if not provider_name: return None
+    token = set_hermes_home_override(home)
+    try:
+        from plugins.memory import load_memory_provider
+        provider = load_memory_provider(provider_name)
+        callback = getattr(provider, name, None)
+        return callback(str(home), *args) if callable(callback) else None
+    finally:
+        reset_hermes_home_override(token)
+
+
+def filter_history(database, rows):
+    authorize_history(Path(database).resolve().parent)
+    rows = list(rows)
+    if not rows: return rows
+    result = _profile_hook(Path(database).resolve().parent, "filter_native_history", str(Path(database).resolve()), rows)
+    filtered=rows if result is None else result
+    trace=_native_read_trace.get()
+    if trace is not None:
+        receipt=_profile_hook(Path(database).resolve().parent,'native_read_evidence',str(Path(database).resolve()),filtered)
+        trace.append(receipt if receipt is not None else {'complete':False,'record_ids':[]})
+    return filtered
+
+
+def filter_search(database, matches):
+    matches = filter_history(database, matches)
+    # Neighbour snippets require their own row identity to avoid resurrecting
+    # deleted evidence. Discard unidentifiable context rather than guess.
+    for match in matches:
+        if match.get("context"):
+            match["context"] = filter_history(database, match["context"])
+    return matches
+
+
+def check_cron_delivery(home, job, targets, content=None):
+    run_id = job.get("_memory_run_id") or job.get("execution_id") or ""
+    result = _profile_hook(home, "check_native_delivery", str(job["id"]), target_keys(targets), run_id, content)
+    if result is False:
+        raise PermissionError("Memory-bearing cron output cannot be delivered outside its recorded recipient scope")
+
+
+@dataclass(frozen=True)
+class MemoryReadScope:
+    home: str
+    allowed: bool
+    provider: object = None
+
+
+_read_scope = ContextVar("memory_read_scope", default=None)
+
+
+@contextmanager
+def native_scope(home, allowed, provider=None):
+    token = _read_scope.set(MemoryReadScope(str(Path(home).resolve()), bool(allowed), provider))
+    try: yield
+    finally: _read_scope.reset(token)
+
+
+def agent_memory_scope(fn):
+    @wraps(fn)
+    def scoped(agent, *args, **kwargs):
+        from hermes_constants import get_hermes_home
+        providers = getattr(getattr(agent, '_memory_manager', None), 'providers', ())
+        # Each configured provider may veto native recall. Missing manager is
+        # denied for a profile whose backend requires authenticated history.
+        policies = [p for p in providers if hasattr(p, 'access_allowed')]
+        allowed = bool(policies) and all(p.access_allowed is True for p in policies)
+        provider = policies[0] if len(policies) == 1 else None
+        for policy in policies:
+            check=getattr(policy,'check_session_epoch',None)
+            if callable(check):check()
+        with native_scope(getattr(provider, 'home', get_hermes_home()), allowed, provider):
+            return fn(agent, *args, **kwargs)
+    return scoped
+
+
+def local_memory_scope(fn):
+    @wraps(fn)
+    def scoped(*args, **kwargs):
+        from hermes_constants import get_hermes_home
+        with native_scope(get_hermes_home(), True):
+            return fn(*args, **kwargs)
+    return scoped
+
+
+def authorize_history(home):
+    scope = _read_scope.get()
+    if scope is not None and Path(scope.home).resolve()!=Path(home).resolve() and _profile_hook(scope.home,'requires_native_scope') is True:
+        raise PermissionError('Cross-profile native memory access requires an explicit target-profile session')
+    if scope is None:
+        from tui_gateway.transport import current_transport
+        context = gui_context(current_transport(), home)
+        result = _profile_hook(home, 'authorize_native_history', context)
+    else:
+        result = _profile_hook(home, 'authorize_native_history', scope)
+    if result is False:
+        raise PermissionError('Native memory requires an authenticated caller in the selected profile')
+
+
+def filter_cron_continuity(home, job, content, kind, source_job_id=None):
+    from cron.scheduler import _resolve_delivery_targets, _normalize_deliver_value
+    context = cron_context(home, job, job.get('_memory_run_id', ''),
+                           _resolve_delivery_targets(job),
+                           _normalize_deliver_value(job.get('deliver', 'local')) == 'local')
+    result = _profile_hook(home, 'filter_native_continuity', context, content, kind, source_job_id)
+    return content if result is None else result
+
+
+def register_cron_artifact(agent, job_id, content, kind='output'):
+    receipts=[]
+    for provider in getattr(getattr(agent, '_memory_manager', None), 'providers', ()):
+        callback=getattr(provider, 'register_native_artifact', None)
+        if callable(callback) and getattr(provider, 'access_allowed', True):
+            receipts.append(callback(str(job_id), content, kind))
+    return receipts
+
+
+
+def _notepad_provider(job_id):
+    from hermes_constants import get_hermes_home
+    home=get_hermes_home()
+    if _profile_hook(home,'requires_native_scope') is not True:return None
+    scope=_read_scope.get()
+    if not scope or not scope.allowed or Path(scope.home).resolve()!=Path(home).resolve():
+        raise PermissionError('Native notepad requires authenticated memory scope')
+    provider=scope.provider
+    context=getattr(provider,'host_context',None)
+    if not context or context.kind!='cron' or context.job_id!=str(job_id):
+        raise PermissionError('Native notepad requires its producing job scope')
+    return provider
+
+
+def filter_notepad_notes(job_id, notes):
+    import json
+    provider=_notepad_provider(job_id)
+    if provider is None or not notes:return notes
+    content=json.dumps(notes,sort_keys=True)
+    filtered=provider.filter_native_continuity(provider.home,provider.host_context,content,'notepad')
+    return json.loads(filtered) if filtered else []
+
+
+def guard_notepad_change(job_id, notes):
+    _notepad_provider(job_id)
+    if notes and filter_notepad_notes(job_id,notes)!=notes:
+        raise PermissionError('Untracked or forgotten notepad must be explicitly cleared before reuse')
+
+
+def commit_notepad_change(job_id, notes):
+    import json
+    provider=_notepad_provider(job_id)
+    if provider is not None:
+        provider.register_native_artifact(str(job_id),json.dumps(notes,sort_keys=True),'notepad')
+
+
+
+def reset_provider_memory(home, scope='canonical'):
+    return _profile_hook(home,'reset_native_memory',scope)
+
+
+_native_read_trace = ContextVar('native_read_trace', default=None)
+
+
+def native_recall(callback):
+    """Attach host-collected canonical references to a native tool response."""
+    import json
+    trace=[];token=_native_read_trace.set(trace)
+    try: result=callback()
+    finally:_native_read_trace.reset(token)
+    try: payload=json.loads(result)
+    except (ValueError,TypeError):return result
+    if isinstance(payload,dict):
+        payload['_memory_read']={'tracked':bool(trace) and all(r['complete'] for r in trace),
+                                 'record_ids':sorted({rid for r in trace for rid in r['record_ids']})}
+        return json.dumps(payload,ensure_ascii=False)
+    return result
+
+
+
+def verify_memory_skill(path,content):
+    # Only explicitly managed exports use this optional lifecycle contract.
+    import yaml
+    if not content.startswith('---'):return
+    front=content.split('---',2)
+    if len(front)<3:return
+    metadata=yaml.safe_load(front[1]) or {}
+    if not isinstance(metadata,dict) or metadata.get('memory-provider-managed') is not True:return
+    from hermes_constants import get_hermes_home
+    try:valid=_profile_hook(get_hermes_home(),'verify_exported_skill',str(path),content)
+    except Exception:valid=False
+    if valid is not True:raise PermissionError('Memory-backed skill is inactive, changed, or unavailable; re-evaluate and explicitly export it before use')
+
+
+def retire_notepad(job_id):
+    from hermes_constants import get_hermes_home
+    return _profile_hook(get_hermes_home(),'retire_native_notepad',str(job_id))
+
+
+def authorize_memory_delivery(platform,chat_id,thread_id,content,media):
+    scope=_read_scope.get()
+    callback=getattr(scope.provider if scope else None,'authorize_tool_delivery',None)
+    if callable(callback):callback(str(platform),str(chat_id),str(thread_id or ''),content,media)
+
+
+def filter_session_metadata(database,data):
+    home=Path(database).resolve().parent
+    authorize_history(home)
+    result=_profile_hook(home,'filter_native_session_metadata',dict(data))
+    return data if result is None else result
diff --git a/agent/memory_manager.py b/agent/memory_manager.py
index d7f9caa632..0142d94133 100644
--- a/agent/memory_manager.py
+++ b/agent/memory_manager.py
@@ -733,6 +733,42 @@ class MemoryManager:
         external = [p for p in self._providers if p.name != "builtin"]
         self._each_provider("on_memory_write failed", _notify, providers=external)
 
+    def create_native_memory_store(self, **kwargs):
+        """Return the one external provider's native-store replacement, if offered."""
+        for provider in self._providers:
+            if provider.name == "builtin":
+                continue
+            try:
+                store = provider.create_native_memory_store(**kwargs)
+                if store is not None:
+                    return store
+            except Exception as exc:
+                logger.warning("Memory provider '%s' canonical store init failed: %s", provider.name, exc)
+                raise
+        return None
+
+    def observe_tool_result(self, tool_name: str, args: Dict[str, Any], result: Any,
